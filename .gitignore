# --- Environment & Güvenlik (Çok Önemli!) ---
.env
.env.*
!.env.example

# RSA Anahtarları ve Sertifikalar (BUNLAR ASLA GİT'E GİTMEMELİ)
*.pem
*.key
*.p12
*.pfx
*.keystore
backend/keys/
backend/client_keys/
ad-b/keys/

# Nginx şifre dosyası
nginx/.htpasswd

# --- Veritabanı yedekleri (kişisel veri içerir!) ---
*.sql
*.dump
BackupFolder/
Linux_Migration_Pack/
db-tables.txt

# --- Kullanıcı içeriği ---
# Kullanıcıların yüklediği görseller ve feedbackler
backend/user_uploads/
# Admin paneli ürün fotoğrafları (Klasör kalsın, içindekiler gitmesin)
ad-b/product-photos/*
!ad-b/product-photos/.gitkeep

# --- Node.js Standartları ---
node_modules/
npm-debug.log
yarn-error.log

# --- Python (AI scripti için oluşan gereksiz dosyalar) ---
__pycache__/
*.pyc
venv/

# --- İşletim Sistemi Dosyaları ---
.DS_Store
Thumbs.db
