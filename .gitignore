# --- Kullanıcı İstekleri ---
# Nginx şifre dosyası
nginx/.htpasswd

# Admin paneli ürün fotoğrafları (Klasör kalsın, içindekiler gitmesin istiyorsan)
ad-b/product-photos/*
!ad-b/product-photos/.gitkeep

# --- Node.js Standartları ---
node_modules/
npm-debug.log
yarn-error.log
package-lock.json # (Opsiyonel: Genelde kalması önerilir ama bazen conflict yaratırsa silinebilir, şimdilik kalsın)

# --- Environment & Güvenlik (Çok Önemli!) ---
.env
.env.production
.env.local

# --- Clear Cart Backend Özel ---
# Kullanıcıların yüklediği görseller ve feedbackler
backend/user_uploads/

# RSA Anahtarları ve Sertifikalar (BUNLAR ASLA GİT'E GİTMEMELİ)
backend/keys/
backend/client_keys/

# --- Python (AI scripti için oluşan gereksiz dosyalar) ---
__pycache__/
*.pyc

# --- İşletim Sistemi Dosyaları ---
.DS_Store
Thumbs.db