# ============================================================
# Clear Cart — Ortam Değişkeni Şablonu
#
# Kullanım:
#   cp .env.example .env
#   ardından aşağıdaki değerleri kendi değerlerinizle doldurun.
#
# .env dosyası .gitignore'dadır — ASLA commit etmeyin.
# ============================================================

# --- Veritabanı ---
# Güçlü bir şifre üretin:  openssl rand -base64 24
POSTGRES_USER=postgres
POSTGRES_PASSWORD=degistir_guclu_bir_sifre
POSTGRES_DB=clearcart

# --- Uygulama ---
# Üretin:  openssl rand -hex 64
# Not: JWT'ler RS256 ile imzalanır (anahtarlar imaj build'inde üretilir);
# bu değişken simetrik imza gerektiren ek işlevler için ayrılmıştır.
JWT_SECRET=degistir_openssl_rand_hex_64

# --- Google OAuth ---
# Google Cloud Console > Credentials > OAuth 2.0 Client IDs
# Bu değerler gizli değildir (istemci uygulamasına da gömülür).
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
ANDROID_CLIENT_ID_FOR_GOOGLE=xxxxxxxx.apps.googleusercontent.com

# --- NGROK ---
# https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=
